{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "webservice-workload-proof"
      }
    },
    {
      "apiVersion": "apiextensions.crossplane.io/v1beta1",
      "kind": "EnvironmentConfig",
      "metadata": {
        "name": "webservice-workload-proof"
      },
      "data": {
        "baseDomain": "webservice.localhost",
        "providerConfigRef": {
          "name": "default",
          "kind": "ClusterProviderConfig"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "credential",
        "namespace": "webservice-workload-proof"
      },
      "stringData": {
        "token": "fixture-first"
      }
    },
    {
      "apiVersion": "workloads.hops.ops.com.ai/v1alpha1",
      "kind": "WebService",
      "metadata": {
        "name": "collector",
        "namespace": "webservice-workload-proof"
      },
      "spec": {
        "image": "python:3.13-alpine",
        "port": 8080,
        "exposure": "cluster",
        "platformRef": {
          "name": "workload-proof"
        },
        "scaling": {
          "minReplicas": 1,
          "maxReplicas": 1
        },
        "command": [
          "python3",
          "-B",
          "-c",
          "import signal,sys\nsignal.signal(signal.SIGTERM, lambda *_: sys.exit(0))\nimport http.server,json,pathlib,threading,time\nroot=pathlib.Path('/tmp/workload');root.mkdir(exist_ok=True)\ndef tick():\n n=0\n while True:\n  n+=1;(root/'ticks').write_text(str(n));time.sleep(1)\nthreading.Thread(target=tick,daemon=True).start()\nclass Handler(http.server.BaseHTTPRequestHandler):\n def do_GET(self):\n  self.send_response(200);self.end_headers();self.wfile.write(b'ok')\n def log_message(self,*args):pass\nhttp.server.HTTPServer(('0.0.0.0',8080),Handler).serve_forever()\n"
        ],
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "64Mi"
          },
          "limits": {
            "memory": "128Mi"
          }
        },
        "securityContext": {
          "readOnlyRootFilesystem": true
        },
        "volumeMounts": [
          {
            "name": "scratch",
            "mountPath": "/tmp"
          },
          {
            "name": "credential",
            "mountPath": "/var/run/fixture",
            "readOnly": true
          }
        ],
        "probes": {
          "readiness": {
            "httpGet": {
              "path": "/health",
              "port": 8080
            }
          }
        },
        "podTemplate": {
          "securityContext": {
            "runAsUser": 10001,
            "runAsGroup": 10001,
            "fsGroup": 10001
          },
          "volumes": [
            {
              "name": "scratch",
              "emptyDir": {}
            },
            {
              "name": "credential",
              "secret": {
                "secretName": "credential"
              }
            }
          ]
        },
        "sidecars": [
          {
            "name": "worker",
            "image": "python:3.13-alpine",
            "command": [
              "python3",
              "-B",
              "-c",
              "import signal,sys\nsignal.signal(signal.SIGTERM, lambda *_: sys.exit(0))\nimport pathlib,time\np=pathlib.Path('/tmp/worker')\nn=0\nwhile True:\n n+=1;p.write_text(str(n));time.sleep(1)\n"
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "32Mi"
              },
              "limits": {
                "memory": "64Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "scratch",
                "mountPath": "/tmp"
              }
            ],
            "securityContext": {
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ]
      }
    }
  ]
}

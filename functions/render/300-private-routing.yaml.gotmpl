{{- if and $state.platform $state.service.private }}
{{- $s := $state.service }}
{{- $p := $state.platform }}
{{- $g := $p.privateGateway }}
{{- $local := $p.knativeLocalGateway | default (dict "name" "knative-local-gateway-istio" "namespace" "knative-serving" "port" 80) }}
{{- $meta := dict "name" (printf "%s-tls" $name) "namespace" $namespace "labels" $s.labels }}
{{- $listener := dict "name" "web" "hostname" $s.host "port" 80 "protocol" "HTTP" "allowedRoutes" (dict "namespaces" (dict "from" "Selector" "selector" (dict "matchLabels" (dict "kubernetes.io/metadata.name" $namespace)))) }}
{{- if $s.tls }}
  {{- $certmeta := deepCopy $meta }}
  {{- $_ := set $certmeta "annotations" (dict "networking.knative.dev/certificate.class" "cert-manager.certificate.networking.knative.dev") }}
  {{- $cert := dict "apiVersion" "networking.internal.knative.dev/v1alpha1" "kind" "Certificate" "metadata" $certmeta "spec" (dict "dnsNames" (list $s.host) "domain" $p.baseDomain "secretName" (printf "%s-tls" $name)) }}
{{ include "webservice.object" (dict "state" $state "key" "certificate" "manifest" $cert "policy" "DeriveFromObject") }}
  {{- $secret := dict "apiVersion" "v1" "kind" "Secret" "metadata" $meta }}
  {{- $secretPolicy := list "Observe" }}
  {{- if or (has "*" $state.spec.effective.managementPolicies) (has "Delete" $state.spec.effective.managementPolicies) }}{{- $secretPolicy = append $secretPolicy "Delete" }}{{- end }}
{{ include "webservice.object" (dict "state" $state "key" "tls-secret" "manifest" $secret "managementPolicies" $secretPolicy) }}
{{ include "webservice.usage" (dict "state" $state "by" "certificate" "of" "tls-secret") }}

  {{- $grant := dict "apiVersion" "gateway.networking.k8s.io/v1beta1" "kind" "ReferenceGrant" "metadata" $meta "spec" (dict "from" (list (dict "group" "gateway.networking.k8s.io" "kind" "Gateway" "namespace" $g.namespace)) "to" (list (dict "group" "" "kind" "Secret" "name" (printf "%s-tls" $name)))) }}
{{ include "webservice.object" (dict "state" $state "key" "tls-grant" "manifest" $grant) }}
  {{- $_ := set $listener "port" 443 }}{{- $_ := set $listener "protocol" "HTTPS" }}
  {{- $_ := set $listener "tls" (dict "mode" "Terminate" "certificateRefs" (list (dict "kind" "Secret" "name" (printf "%s-tls" $name) "namespace" $namespace))) }}
{{- end }}
{{- $gateway := dict "apiVersion" "gateway.networking.k8s.io/v1" "kind" "Gateway" "metadata" (dict "name" $s.gatewayName "namespace" $g.namespace "labels" $s.labels) "spec" (dict "gatewayClassName" ($g.className | default "istio") "addresses" (list (dict "type" "Hostname" "value" $g.service)) "listeners" (list $listener)) }}
{{ include "webservice.object" (dict "state" $state "key" "gateway" "manifest" $gateway "policy" "DeriveFromCelQuery" "query" "object.status.conditions.exists(c, c.type == 'Accepted' && c.status == 'True') && object.status.conditions.exists(c, c.type == 'Programmed' && c.status == 'True')") }}
{{- $backend := dict "apiVersion" "gateway.networking.k8s.io/v1beta1" "kind" "ReferenceGrant" "metadata" (dict "name" $s.gatewayName "namespace" $local.namespace "labels" $s.labels) "spec" (dict "from" (list (dict "group" "gateway.networking.k8s.io" "kind" "HTTPRoute" "namespace" $namespace)) "to" (list (dict "group" "" "kind" "Service" "name" $local.name))) }}
{{ include "webservice.object" (dict "state" $state "key" "backend-grant" "manifest" $backend) }}
{{- $scheme := ternary "https" "http" $s.tls }}
{{- $filters := list (dict "type" "URLRewrite" "urlRewrite" (dict "hostname" $s.clusterHost)) (dict "type" "RequestHeaderModifier" "requestHeaderModifier" (dict "set" (list (dict "name" "X-Forwarded-Host" "value" $s.host) (dict "name" "X-Forwarded-Proto" "value" $scheme) (dict "name" "X-Auth-Request-Redirect" "value" (printf "%s://%s%%REQ(:PATH)%%" $scheme $s.host))))) }}
{{- $route := dict "apiVersion" "gateway.networking.k8s.io/v1" "kind" "HTTPRoute" "metadata" (dict "name" (printf "%s-private" $name) "namespace" $namespace "labels" $s.labels "annotations" (dict "external-dns.alpha.kubernetes.io/cloudflare-proxied" "false" "external-dns.alpha.kubernetes.io/ttl" "120")) "spec" (dict "parentRefs" (list (dict "name" $s.gatewayName "namespace" $g.namespace "sectionName" "web")) "hostnames" (list $s.host) "rules" (list (dict "filters" $filters "backendRefs" (list (dict "group" "" "kind" "Service" "name" $local.name "namespace" $local.namespace "port" ($local.port | default 80)))))) }}
{{ include "webservice.object" (dict "state" $state "key" "route" "manifest" $route "policy" "DeriveFromCelQuery" "query" "object.status.parents.exists(p, p.conditions.exists(c, c.type == 'Accepted' && c.status == 'True') && p.conditions.exists(c, c.type == 'ResolvedRefs' && c.status == 'True'))") }}
{{- range $parent := list "gateway" "backend-grant" "service" }}
{{ include "webservice.usage" (dict "state" $state "by" "route" "of" $parent) }}
{{- end }}
{{- if $s.tls }}
{{ include "webservice.usage" (dict "state" $state "by" "gateway" "of" "certificate") }}
{{ include "webservice.usage" (dict "state" $state "by" "gateway" "of" "tls-grant") }}
{{- end }}
{{- end }}

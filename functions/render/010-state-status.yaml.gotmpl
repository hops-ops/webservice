{{- if $state.platform }}
{{- $obs := $state.observed }}
{{- $ks := (get $obs "service" | default dict).manifest | default dict }}
{{- $url := dig "status" "url" "" $ks }}
{{- if $state.service.private }}
  {{- $route := (get $obs "route" | default dict).manifest | default dict }}
  {{- $url = "" }}
  {{- if (dig "metadata" "uid" "" $route) }}
    {{- $url = printf "%s://%s" (ternary "https" "http" $state.service.tls) (first $route.spec.hostnames) }}
  {{- end }}
{{- end }}
{{- $keys := list "service" }}
{{- if $state.service.private }}
  {{- $keys = concat $keys (list "route" "gateway" "backend-grant") }}
  {{- if $state.service.tls }}{{- $keys = concat $keys (list "certificate" "tls-secret" "tls-grant") }}{{- end }}
{{- end }}
{{- if $state.service.auth }}
  {{- $keys = concat $keys (list "oidc" "client-secret" "cookie" "cookie-generator") }}
  {{- if $state.platform.auth.caBundle }}{{- $keys = append $keys "issuer-ca" }}{{- end }}
{{- end }}
{{- $ready := true }}
{{- range $keys }}{{- $ready = and $ready ((get $obs . | default dict).ready | default false) }}{{- end }}
{{- $_ := set $state "status" (dict "ready" $ready "url" $url "serviceUrl" (dig "status" "url" "" $ks) "latestReadyRevision" (dig "status" "latestReadyRevisionName" "" $ks)) }}
{{- end }}
